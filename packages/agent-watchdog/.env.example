# packages/agent-watchdog/.env.example
#
# Copy to .env for local runs:   node --env-file=.env bin/agent-watchdog.js run --dry-run
# Precedence: CLI flag > environment variable > config-file default.
# Every value is validated at startup (zod); the run fails fast on a bad or missing value and
# writes the effective, redacted configuration to runs/<date>/config.effective.json.
# In EKS: non-secrets arrive via a ConfigMap (envFrom), secrets via an External Secrets-managed
# Secret (envFrom secretRef). Nothing below is ever committed with a real value.

# ---------------------------------------------------------------------------
# Secrets — environment only. Never in config files, the ConfigMap, or run records.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=                        # read by the Claude Code runtime the Agent SDK launches
SLACK_BOT_TOKEN=                          # scopes: chat:write, files:write, reactions:read, channels:history
AGENT_WATCHDOG_GRAFANA_TOKEN=             # hosted-watchdog Grafana service-account token, Viewer role
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_WATCHDOG_DOCS_MCP_TOKEN=            # only if cht-docs-mcp requires one

# ---------------------------------------------------------------------------
# Model and engine
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_MODEL=claude-fable-5-1     # analysis and roll-up calls
AGENT_WATCHDOG_EFFORT=max                 # low | medium | high | xhigh | max
AGENT_WATCHDOG_MODEL_FEEDBACK=            # optional override for feedback-note parsing (default: MODEL)
AGENT_WATCHDOG_MODEL_CALIBRATION=         # optional override for the weekly calibration summary (default: MODEL)
AGENT_WATCHDOG_MODEL_DISTILL=             # optional override for corpus distillation (default: MODEL)
AGENT_WATCHDOG_ENGINE=sdk                 # sdk | cli   (cli shells out to `claude --bare -p` for observation)

# ---------------------------------------------------------------------------
# Bounds — every model interaction is capped
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_MAX_BUDGET_USD_PROJECT=    # per-project analysis call
AGENT_WATCHDOG_MAX_BUDGET_USD_RUN=        # whole run: all projects + roll-up + feedback parsing
AGENT_WATCHDOG_MAX_TURNS=20               # agent turns per analysis call
AGENT_WATCHDOG_MODEL_TIMEOUT_MS=900000    # abort a single analysis call after 15 minutes
AGENT_WATCHDOG_HTTP_TIMEOUT_MS=15000      # Grafana / Prometheus / Slack requests
AGENT_WATCHDOG_VERIFY_MAX_RETRIES=2       # gate failures returned to the model before degrading
AGENT_WATCHDOG_PASSES=2                   # analysis passes per project (min 1; hard cap in code)
AGENT_WATCHDOG_PASS_CONVERGENCE=true      # stop early when a pass changes nothing material

# ---------------------------------------------------------------------------
# Endpoints and identifiers (per environment)
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_GRAFANA_URL=https://watchdog.app.medicmobile.org
AGENT_WATCHDOG_PROMETHEUS_DATASOURCE_UID= # Prometheus datasource proxied through Grafana
AGENT_WATCHDOG_SLACK_CHANNEL_ID=
AGENT_WATCHDOG_DOCS_MCP_URL=              # cht-docs-mcp endpoint
LANGFUSE_HOST=
AGENT_WATCHDOG_PROMPTS_URL=               # footer link → prompts in cht-ai-tools
AGENT_WATCHDOG_CONFIG_URL=                # footer link → deployment config in medic-infrastructure

# ---------------------------------------------------------------------------
# Storage and retention
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_DATA_DIR=/data                          # PVC mount: runs/, memory/, feedback.jsonl, proposals/
AGENT_WATCHDOG_CONFIG_DIR=/etc/agent-watchdog          # ConfigMap mount: projects.yaml, dashboards.yaml, ...
AGENT_WATCHDOG_CORPUS_RAW_DIR=/data/knowledge-corpus/raw
AGENT_WATCHDOG_RETENTION_RAW_DAYS=14                   # raw series and rendered images
AGENT_WATCHDOG_RETENTION_DAYS=30                       # deltas, candidates, items, feedback, memory

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_FEEDBACK_LOOKBACK_RUNS=7
AGENT_WATCHDOG_MEMORY_MAX_TOKENS=4000
AGENT_WATCHDOG_DRY_RUN=false               # true: produce every artefact, post nothing (same as --dry-run)

# ---------------------------------------------------------------------------
# Logging, tracing, runtime
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_LOG_LEVEL=info              # trace | debug | info | warn | error
AGENT_WATCHDOG_LOG_FORMAT=json             # json | pretty
MCP_TIMEOUT=30000                          # Claude Code MCP server startup timeout (ms)

# ---------------------------------------------------------------------------
# Deliberately NOT configurable here
# ---------------------------------------------------------------------------
# - The tool allow-list, disabled shell and web tools, permission handling, and the
#   verification gate are code (constitution IV, V) — no env var turns them off.
# - Structured, reviewed policy lives in versioned files under AGENT_WATCHDOG_CONFIG_DIR:
#   projects.yaml (owners, per-project thresholds, expected-load windows), dashboards.yaml
#   (priority list), thresholds.yaml (defaults), prompts/, schema/findings.schema.json.
# - Per-run choices are flags: --date, --project, --stage, --engine, --dry-run, --force, --since.
