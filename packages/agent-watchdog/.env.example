# packages/agent-watchdog/.env.example
#
# Copy to .env for local runs:   node --env-file=.env bin/agent-watchdog.js run --dry-run
# Precedence: CLI flag > environment variable > config-file default.
# Every value is validated at startup (zod); the run fails fast on a bad or missing value and
# writes the effective, redacted configuration to runs/<date>/config.effective.json.
# In EKS: non-secrets arrive via a ConfigMap (envFrom), secrets via an External Secrets-managed
# Secret (envFrom secretRef). Nothing below is ever committed with a real value.

# ---------------------------------------------------------------------------
# Secrets — environment only. Never in config files, the ConfigMap, or run records.
# ---------------------------------------------------------------------------
# read by the Claude Code runtime; blank with AGENT_WATCHDOG_ENGINE=cli = your claude login
ANTHROPIC_API_KEY=
# scopes: chat:write, files:write, reactions:read, reactions:write, channels:history
SLACK_BOT_TOKEN=
# hosted-watchdog Grafana service-account token, Viewer role
AGENT_WATCHDOG_GRAFANA_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# only if cht-docs-mcp requires one
AGENT_WATCHDOG_DOCS_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Model and engine
# ---------------------------------------------------------------------------
# analysis and roll-up calls; ids as the API names them (claude-opus-4-8, not 4.8)
AGENT_WATCHDOG_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
AGENT_WATCHDOG_EFFORT=high
# optional override for feedback-note parsing (default: MODEL)
AGENT_WATCHDOG_MODEL_FEEDBACK=
# optional override for the weekly calibration summary (default: MODEL)
AGENT_WATCHDOG_MODEL_CALIBRATION=
# optional override for corpus distillation (default: MODEL)
AGENT_WATCHDOG_MODEL_DISTILL=
# sdk | cli   (cli shells out to `claude -p`: --bare with a key, your claude login without)
AGENT_WATCHDOG_ENGINE=sdk

# ---------------------------------------------------------------------------
# Bounds — every model interaction is capped
# ---------------------------------------------------------------------------
# per-project analysis session (hard cap 10.00 in code)
AGENT_WATCHDOG_MAX_BUDGET_USD_PROJECT=2.00
# whole run; no new session once spent, remaining projects are named (hard cap 100.00)
AGENT_WATCHDOG_MAX_BUDGET_USD_RUN=25.00
# agent turns per analysis call
AGENT_WATCHDOG_MAX_TURNS=20
# abort a single analysis call after 15 minutes
AGENT_WATCHDOG_MODEL_TIMEOUT_MS=900000
# Grafana API / Slack / link-resolution requests
AGENT_WATCHDOG_HTTP_TIMEOUT_MS=15000
# range and instant queries through the datasource proxy (one retry)
AGENT_WATCHDOG_QUERY_TIMEOUT_MS=30000
# gate failures returned to the model before degrading
AGENT_WATCHDOG_VERIFY_MAX_RETRIES=2
# analysis passes per project (min 1; hard cap in code); 2 adds a review pass
AGENT_WATCHDOG_PASSES=1
# stop early when a pass changes nothing material
AGENT_WATCHDOG_PASS_CONVERGENCE=true
# whole-run wall clock; on expiry finish with what we have and say so
AGENT_WATCHDOG_RUN_TIMEOUT_MS=3600000
# concurrent project sessions (hard cap 8 in code)
AGENT_WATCHDOG_PROJECT_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Endpoints and identifiers (per environment)
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_GRAFANA_URL=https://watchdog.example.org
# Prometheus datasource proxied through Grafana
AGENT_WATCHDOG_PROMETHEUS_DATASOURCE_UID=
AGENT_WATCHDOG_SLACK_CHANNEL_ID=
# internal | none: link the report's alerts, dashboards and panels to the hosted watchdog, or name them only
AGENT_WATCHDOG_REPORT_LINKS=internal
# cht-docs-mcp endpoint
AGENT_WATCHDOG_DOCS_MCP_URL=
# the Langfuse v5 SDK reads LANGFUSE_BASE_URL, not LANGFUSE_HOST
LANGFUSE_BASE_URL=
# footer link → this feature's specs/ directory in cht-ai-tools (replaced AGENT_WATCHDOG_PROMPTS_URL)
AGENT_WATCHDOG_SPECS_URL=
# footer link → deployment config in medic-infrastructure
AGENT_WATCHDOG_CONFIG_URL=

# ---------------------------------------------------------------------------
# Storage and retention
# ---------------------------------------------------------------------------
# PVC mount: runs/, memory/, feedback.jsonl, proposals/
AGENT_WATCHDOG_DATA_DIR=/data
# ConfigMap mount: projects.yaml, dashboards.yaml, ...
AGENT_WATCHDOG_CONFIG_DIR=/etc/agent-watchdog
AGENT_WATCHDOG_CORPUS_RAW_DIR=/data/knowledge-corpus/raw
# raw series
AGENT_WATCHDOG_RETENTION_RAW_DAYS=14
# deltas, candidates, items, feedback, memory
AGENT_WATCHDOG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
AGENT_WATCHDOG_FEEDBACK_LOOKBACK_RUNS=7
# days a feedback record adjusts ranking (hard cap 365); records are kept permanently
AGENT_WATCHDOG_FEEDBACK_INFLUENCE_DAYS=30
AGENT_WATCHDOG_MEMORY_MAX_TOKENS=4000
# true: produce every artefact, post nothing (same as --dry-run)
AGENT_WATCHDOG_DRY_RUN=false

# ---------------------------------------------------------------------------
# Logging, tracing, runtime
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
AGENT_WATCHDOG_LOG_LEVEL=info
# json | pretty
AGENT_WATCHDOG_LOG_FORMAT=json
# Claude Code MCP server startup timeout (ms)
MCP_TIMEOUT=30000
# explicit `claude` executable for the cli engine; default: `claude` on PATH
AGENT_WATCHDOG_CLAUDE_PATH=

# ---------------------------------------------------------------------------
# Deliberately NOT configurable here
# ---------------------------------------------------------------------------
# - The tool allow-list, disabled shell and web tools, permission handling, and the
#   verification gate are code (constitution IV, V) — no env var turns them off.
# - Structured, reviewed policy lives in versioned files under AGENT_WATCHDOG_CONFIG_DIR:
#   projects.yaml (owners, per-project thresholds, expected-load windows), dashboards.yaml
#   (priority list), thresholds.yaml (defaults), prompts/, schema/findings.schema.json.
# - Per-run choices are flags: --date, --project, --group, --stage, --engine, --dry-run, --force, --since.
