<!doctype html>
<!--
  Design read (recorded once, per the plan; revision 24 redesign under the taste skill, dials VARIANCE 2 · MOTION 0 ·
  DENSITY 6): the reader is an engineer who opened the report from the thread to act on a check or dig further. One
  column of about 65 characters on a warm monochrome canvas; hierarchy by weight and spacing, not boxes; the four
  pale accents carry meaning only (severity, alert importance, the kind of post); numbers are tabular and rounded for
  reading; links are visible but quiet. No external asset, no script, nothing depends on the network. Every value is
  rendered through Handlebars escaping; the only raw markup is the numeric SVG sparkline. The code-placed markers of
  FR-082 stay as the one deliberate exception to the no-emoji rule, because they are the same marks the Slack post
  carries.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Watchdog report {{run_id}}</title>
<style>
  :root {
    color-scheme: light;
    --bg: #F7F6F3; --surface: #FFFFFF; --border: #EAEAEA; --rule: #E6E4DF;
    --ink: #37352F; --muted: #787774; --faint: #9B9A97;
    --red-bg: #FDEBEC; --red: #9F2F2D; --amber-bg: #FBF3DB; --amber: #956400;
    --blue-bg: #E1F3FE; --blue: #0B6E99; --blue-rule: #C9E2F0; --green-bg: #EDF3EC; --green: #346538;
    --sans: 'SF Pro Display', 'Geist Sans', 'Helvetica Neue', 'Switzer', system-ui, sans-serif;
    --mono: 'Geist Mono', 'SF Mono', 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 40px 24px 72px; background: var(--bg); color: var(--ink); font: 15px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  main { max-width: 760px; margin: 0 auto; }
  a { color: var(--blue); text-decoration: none; border-bottom: 1px solid var(--blue-rule); }
  a:hover { border-bottom-color: var(--blue); }
  code, .mono { font-family: var(--mono); font-size: 0.86em; }
  .tabular { font-variant-numeric: tabular-nums; }
  .eyebrow { font-family: var(--mono); font-size: 12px; color: var(--muted); letter-spacing: 0.01em; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .eyebrow .sep { color: var(--faint); }
  .chip { display: inline-block; padding: 1px 8px; border-radius: 6px; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; background: var(--border); color: var(--muted); }
  .kind-degraded { background: var(--amber-bg); color: var(--amber); }
  .kind-heartbeat { background: var(--green-bg); color: var(--green); }
  .kind-failure { background: var(--red-bg); color: var(--red); }
  .sev-high, .sev-critical { background: var(--red-bg); color: var(--red); }
  .sev-medium { background: var(--amber-bg); color: var(--amber); }
  .sev-low { background: var(--border); color: var(--muted); }
  #brief-summary { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 28px 32px; margin-top: 16px; }
  h1 { font-size: 24px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 16px; }
  h2 { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 48px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--rule); }
  h3 { font-size: 15px; font-weight: 600; margin: 24px 0 8px; }
  ul.bullets { margin: 0; padding-left: 20px; }
  ul.bullets li { margin: 8px 0; font-size: 16px; }
  ul.sub { margin: 4px 0 0; padding-left: 18px; list-style: circle; }
  ul.sub li { margin: 2px 0; font-size: 14px; color: var(--ink); }
  .notice { margin: 14px 0 0; padding: 2px 0 2px 14px; border-left: 2px solid var(--rule); color: var(--muted); font-size: 14px; }
  .checked { margin: 18px 0 0; font-size: 13px; color: var(--muted); }
  article.item { padding: 22px 0 24px; border-bottom: 1px solid var(--rule); }
  article.item:last-of-type { border-bottom: 0; }
  .item-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .item-head .rank { font-family: var(--mono); font-size: 14px; font-weight: 600; color: var(--muted); min-width: 2.2em; }
  .item-head .host { font-size: 17px; font-weight: 600; }
  .item-head .metric { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .item-head .open { margin-left: auto; font-size: 13px; }
  .item-meta { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 8px 0 0 calc(2.2em + 12px); font-size: 13px; color: var(--muted); }
  .item-meta .label { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin-right: 6px; }
  .item-meta code { color: var(--muted); }
  .body { margin-left: calc(2.2em + 12px); }
  table.evidence { border-collapse: collapse; margin: 14px 0 6px; }
  table.evidence td { padding: 3px 18px 3px 0; vertical-align: baseline; font-variant-numeric: tabular-nums; }
  table.evidence td.window { color: var(--muted); font-size: 13px; }
  table.evidence td.value { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  table.evidence td.unit { color: var(--muted); font-size: 13px; }
  table.evidence td.note { color: var(--faint); font-size: 12px; }
  .spark { margin: 2px 0 8px; color: var(--muted); }
  p.why { margin: 10px 0 0; max-width: 65ch; }
  p.check { margin: 8px 0 0; max-width: 65ch; }
  p.check .label { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); margin-right: 8px; }
  ul.related { margin: 14px 0 0; padding: 0 0 0 14px; border-left: 2px solid var(--rule); list-style: none; }
  ul.related li { margin: 10px 0; font-size: 14px; }
  ul.related .relation { font-style: italic; color: var(--muted); margin-right: 8px; }
  ul.related .host { font-weight: 600; }
  ul.related .metric { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-left: 8px; }
  ul.related p { margin: 4px 0 0; max-width: 65ch; }
  table.rows { border-collapse: collapse; width: 100%; font-size: 14px; }
  table.rows td { padding: 6px 16px 6px 0; border-bottom: 1px solid var(--rule); vertical-align: baseline; font-variant-numeric: tabular-nums; }
  table.rows tr:last-child td { border-bottom: 0; }
  table.rows td.muted { color: var(--muted); font-size: 13px; }
  table.rows td.host { font-weight: 600; }
  table.rows td.value { font-weight: 600; }
  .group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: 24px 0 6px; }
  .group-head .title { font-size: 15px; font-weight: 600; }
  .group-head .summary { color: var(--muted); font-size: 13px; }
  footer { margin-top: 56px; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 13px; color: var(--muted); }
  footer .links { display: flex; flex-wrap: wrap; gap: 4px 8px; }
  footer .cite { margin: 10px 0 0; max-width: 65ch; }
  @media (max-width: 600px) { body { padding: 20px 14px 48px; } #brief-summary { padding: 20px; } .item-meta, .body { margin-left: 0; } }
</style>
</head>
<body>
<main>
<div class="eyebrow">agent-watchdog <span class="sep">·</span> run {{run_id}} <span class="sep">·</span> {{date}} <span class="chip kind-{{kind}}">{{kind_label}}</span></div>
<section id="brief-summary">
  <h1>{{headline}}</h1>
{{#if has_bullets}}
  <ul class="bullets">
{{#each bullets}}
    <li>{{text}}{{#if has_children}}
      <ul class="sub">
{{#each children}}
        <li>{{text}}</li>
{{/each}}
      </ul>
    {{/if}}</li>
{{/each}}
  </ul>
{{/if}}
{{#each notices}}
  <div class="notice">{{text}}</div>
{{/each}}
  <p class="checked">Checked {{checked.projects}} projects, {{checked.panels}} panels, {{checked.candidates}} candidates.</p>
</section>
{{#if has_items}}
<h2>Items by rank</h2>
{{#each items}}
<article class="item">
  <div class="item-head"><span class="rank">{{rank_text}}</span><span class="chip sev-{{severity}}">{{severity_label}}</span><span class="host">{{host}}</span><span class="metric">{{metric}}</span>{{#if link}}<a class="open" href="{{href link}}">open panel</a>{{/if}}</div>
  <div class="item-meta"><span><span class="label">Persistence</span>{{persisting_text}}</span><span><span class="label">Confidence</span>{{confidence_pct}}%</span><span><span class="label">Id</span><code>{{item_id}}</code></span></div>
  <div class="body">
  <table class="evidence">
{{#each evidence}}
    <tr><td class="window">{{window}}</td><td class="value">{{value}}</td><td class="unit">{{unit}}</td><td class="note">{{note}}</td></tr>
{{/each}}
  </table>
  <div class="spark">{{sparkline samples}}</div>
  <p class="why">{{why_now}}</p>
  <p class="check"><span class="label">Check</span>{{suggested_check}}</p>
{{#if has_related}}
  <ul class="related">
{{#each related}}
    <li><span class="relation">{{relation_text}}</span><span class="rank mono">{{rank_text}}</span> <span class="chip sev-{{severity}}">{{severity_label}}</span> <span class="host">{{host}}</span><span class="metric">{{metric}}</span>{{#if link}} <a href="{{href link}}">open panel</a>{{/if}}<p>{{why_now}}</p></li>
{{/each}}
  </ul>
{{/if}}
  </div>
</article>
{{/each}}
{{/if}}
{{#if has_alerts}}
<h2>Alerts</h2>
{{#each alerts}}
<div class="group-head"><span class="title">{{#if link}}<a href="{{href link}}">{{group}} · {{category}}</a>{{else}}{{group}} · {{category}}{{/if}}</span><span class="chip sev-{{importance}}">{{importance_label}}</span><span class="summary">{{summary_text}}</span></div>
<table class="rows">
{{#each instances}}
  <tr><td>{{#if link}}<a href="{{href link}}">{{title}}</a>{{else}}{{title}}{{/if}}</td><td class="host">{{host}}</td><td class="muted">since {{since}} ({{days_text}})</td><td class="muted">{{flags}}</td></tr>
{{/each}}
</table>
{{/each}}
{{/if}}
{{#if has_standing}}
<h2>Standing conditions</h2>
{{#each standing}}
<h3>{{rule_text}}</h3>
<table class="rows">
{{#each hosts}}
  <tr><td class="muted">{{group}}</td><td class="host">{{#if link}}<a href="{{href link}}">{{host}}</a>{{else}}{{host}}{{/if}}</td><td class="mono muted">{{metric}}</td><td class="value">{{value}}</td><td class="muted">yesterday {{previous}}</td></tr>
{{/each}}
</table>
{{/each}}
{{/if}}
<footer>
  <div class="links">{{#if footer.links}}{{#if footer.prompts_url}}<a href="{{href footer.prompts_url}}">prompts</a>{{else}}<span>prompts</span>{{/if}} · {{#if footer.config_url}}<a href="{{href footer.config_url}}">configuration</a>{{else}}<span>configuration</span>{{/if}} · {{#if footer.trace_url}}<a href="{{href footer.trace_url}}">trace</a>{{else}}<span>trace: none</span>{{/if}}{{else}}<span>prompts · configuration · trace: {{footer.trace_text}}</span>{{/if}} · <span>cost {{footer.cost_text}}</span> · <span>run {{run_id}}</span></div>
  <p class="cite">To cite an item in a thread note, give its number (#rank) or its host and metric; a thumbs up or down in the note is its verdict.</p>
</footer>
</main>
</body>
</html>
